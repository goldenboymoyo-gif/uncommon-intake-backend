# Edge Function secrets. Set them with: npx supabase secrets set --env-file supabase/functions/.env
# Never commit the real file. These never go into the mobile app.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
# Fallback when AI_PROVIDER=huggingface
HF_TOKEN=
HF_MODEL=
HF_TRANSCRIBE_MODEL=
# Decision emails
RESEND_API_KEY=
EMAIL_FROM=
# Shared with the pg_cron job (vault secret "cron_secret")
CRON_SECRET=
